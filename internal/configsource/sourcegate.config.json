{
  "policy": {
    "inform": {
      "groups": {
        "release_metadata": true
      }
    },
    "alert": {
      "groups": {
        "release_metadata": true,
        "name_protection": true,
        "npm_lifecycle": true,
        "npm_dependencies": true,
        "pypi_artifacts": true,
        "source_metadata": true,
        "artifact_behavior": true
      },
      "checks": {
        "protected_packages": {
          "npm": ["react", "lodash", "@tanstack/react-query"],
          "pypi": ["requests", "django"]
        }
      }
    },
    "block": {
      "groups": {
        "npm_lifecycle": true,
        "artifact_safety": true
      }
    }
  }
}
